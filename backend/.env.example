# Base local (si usas Neon, define DATABASE_URL en su lugar)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Menu_Go
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# Genera una clave aleatoria de al menos 32 caracteres
JWT_SECRET=CAMBIA_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS

# Google Identity Services: cliente tipo Web; el correo debe existir en la tabla administrador
GOOGLE_CLIENT_ID=tu-cliente-web.apps.googleusercontent.com
ADMIN_GOOGLE_EMAIL=tu-cuenta-administradora@gmail.com

# Gmail SMTP: usa una contraseña de aplicación; nunca la contraseña normal de Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta-remitente@gmail.com
SMTP_PASSWORD=tu-contrasena-de-aplicacion
SMTP_FROM=MenuGo <tu-cuenta-remitente@gmail.com>

# Orígenes del frontend permitidos por CORS
FRONTEND_URLS=http://localhost:5500,http://127.0.0.1:5500
